{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secpipe.dev/schemas/recon-facts.schema.json",
  "title": "SecPipe recon-facts.json (contract v1)",
  "$comment": "Written by recon (WO-K.4) through ReconFactsCodec (WO-CC.2). Lists are sorted by (file, line, scope) without duplicates and keys are sorted; the codec enforces that on write, readers must not rely on it for foreign input.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entry_surfaces", "sinks_by_family"],
  "properties": {
    "entry_surfaces": { "$ref": "#/$defs/locations" },
    "sinks_by_family": {
      "type": "object",
      "propertyNames": { "pattern": "^CWE-[1-9][0-9]*$" },
      "additionalProperties": { "$ref": "#/$defs/locations" }
    }
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*//)(?!.*/$)(?!/)(?!(.*/)?\\.{1,2}(/|$)).+$"
    },
    "scope": { "type": "string", "pattern": "^[^\\s#()]+#[^\\s#()]+\\([^#()]*\\)$" },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": { "$ref": "#/$defs/relPath" },
        "line": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "scope": { "$ref": "#/$defs/scope" }
      }
    },
    "locations": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/$defs/location" } }
  }
}
