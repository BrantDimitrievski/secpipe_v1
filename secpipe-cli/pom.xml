<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ca.carleton.secpipe</groupId>
    <artifactId>secpipe-parent</artifactId>
    <version>0.2.0-SNAPSHOT</version>
  </parent>

  <artifactId>secpipe-cli</artifactId>
  <name>SecPipe :: cli</name>
  <description>picocli commands and the shaded secpipe.jar.</description>

  <dependencies>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-contracts</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-validators</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-sarif</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-core</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-graph-langgraph4j</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-llm</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-llm-openai</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-llm-anthropic</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-llm-ollama</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-agents</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-sandbox</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-adapter-builtin</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-adapter-pmd</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-adapter-semgrep</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-adapter-spotbugs</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-adapter-joern</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-adapter-codeql</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-adapter-osv</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-adapter-grype</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-adapter-trivy</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-report</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.carleton.secpipe</groupId>
      <artifactId>secpipe-github</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-nop</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <finalName>secpipe</finalName>
    <resources>
      <!-- Only the version file is filtered; other resources (prompts, templates) are copied verbatim. -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>ca/carleton/secpipe/cli/secpipe-version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>ca/carleton/secpipe/cli/secpipe-version.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>ca.carleton.secpipe.cli.SecPipeCli</mainClass>
                  <manifestEntries>
                    <Multi-Release>true</Multi-Release>
                    <Implementation-Title>SecPipe</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
